# Cross-origin isolation: terrain workers share one Earth height grid (SharedArrayBuffer).
# Without these headers the game still works, with a 16 MiB copy per worker.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Vite content hashes change whenever bytes change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML and unversioned files must revalidate after a deploy.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/earth/*
  Cache-Control: no-cache
